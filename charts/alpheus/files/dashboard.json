{
  "title": "Alpheus",
  "uid": "alpheus",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "alpheus"
  ],
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(alpheus_chunks_total, namespace)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2
      },
      {
        "name": "run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(alpheus_chunks_total{namespace=~\"$namespace\"}, run)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Runs finished, by phase and reason",
      "description": "From the controller (GO-138).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase, reason) (increase(alpheus_runs_finished_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{phase}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Restarted attempts, by step and reason",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step, reason) (increase(alpheus_step_restarts_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{step}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Edge lag (chunks committed, not acked)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alpheus_edge_lag{namespace=~\"$namespace\",run=~\"$run\"}",
          "legendFormat": "{{run}} {{edge}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Chunks per second, by step",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (run, step, direction) (rate(alpheus_chunks_total{namespace=~\"$namespace\",run=~\"$run\"}[$__rate_interval]))",
          "legendFormat": "{{run}} {{step}} {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput, by step",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (run, step, direction) (rate(alpheus_bytes_total{namespace=~\"$namespace\",run=~\"$run\"}[$__rate_interval]))",
          "legendFormat": "{{run}} {{step}} {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backpressure: share of time output waited",
      "description": "1 means the step's output waited for its consumers all the time.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (run, step) (rate(alpheus_backpressure_seconds_total{namespace=~\"$namespace\",run=~\"$run\"}[$__rate_interval]))",
          "legendFormat": "{{run}} {{step}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Component counters per second, live",
      "description": "Best effort; the run's status has the exact counts (GO-116).",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (run, step, unit) (rate(alpheus_component_count_total{namespace=~\"$namespace\",run=~\"$run\"}[$__rate_interval]))",
          "legendFormat": "{{run}} {{step}} {{unit}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors, warnings and storage retries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (run, step, level) (increase(alpheus_component_log_entries_total{namespace=~\"$namespace\",run=~\"$run\"}[$__rate_interval]))",
          "legendFormat": "{{run}} {{step}} {{level}}"
        },
        {
          "refId": "B",
          "expr": "sum by (run, step) (increase(alpheus_storage_retries_total{namespace=~\"$namespace\",run=~\"$run\"}[$__rate_interval]))",
          "legendFormat": "{{run}} {{step}} storage retries"
        }
      ]
    }
  ]
}
