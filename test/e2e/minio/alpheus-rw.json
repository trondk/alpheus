{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::alpheus-data", "arn:aws:s3:::alpheus-data/*",
        "arn:aws:s3:::alpheus-results", "arn:aws:s3:::alpheus-results/*",
        "arn:aws:s3:::alpheus-quota", "arn:aws:s3:::alpheus-quota/*"
      ]
    }
  ]
}
